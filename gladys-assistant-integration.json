{
  "manifest_version": 1,
  "type": "device",
  "name": "Serveur API",
  "description": {
    "en": "Starter template showing sensors, a switch, a dimmable light and a smart plug.",
    "fr": "Nodejs API server for running external scripts."
  },
  "version": "1.0.0",
  "docker_image": "ghcr.io/mgrafr/gladys-serve-api:1.0.0",
  "gladys_version": ">=4.86.0",
  "cover_image": "https://raw.githubusercontent.com/GladysAssistant/integration-template-js/master/cover.png",
  "categories": ["environment"],
  "transports": ["local"],
  "config_schema": [
    {
      "key": "intro",
      "type": "section",
      "label": { "en": "Getting started", "fr": "Pour commencer" },
      "description": {
        "en": "The demo  API: , no API key.",
        "fr": "démonstrationAPI."
      }
    }
  ],
  "actions": [
    {
      "key": "test_server",
      "label": { "en": "Test the api server", "fr": "Tester le serveur api" },
      "timeout_seconds": 30
    }
      ]
    }

